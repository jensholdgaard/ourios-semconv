// ourios-semconv — generated OpenTelemetry semantic-convention name
// constants for Ourios's custom metrics and attributes (TypeScript).
//
// GENERATED by `weaver registry generate` from the shared
// `ourios-semconv` registry repo, at the ref this consumer pins in
// `semconv-registry.ref`. Do not edit by hand: change the registry or
// the template *in that repo*, bump the pin here, then regenerate and
// commit the result:
//
//   npm run semconv:generate
//
// The consumer's semconv CI job fails if this file drifts from the
// pinned registry.

/** The semantic-conventions schema URL these constants were generated from. */
export const SCHEMA_URL = "{{ (ctx.groups | first).lineage.provenance.schema_url }}";

// Metric names, descriptions and units. The registry is the single source for
// all three, so a panel that labels a metric reads the description from here
// rather than restating it.
{% for group in ctx.groups | selectattr("type", "equalto", "metric") %}
/** `{{ group.metric_name }}` ({{ group.instrument }}, unit `{{ group.unit }}`). */
export const {{ group.metric_name | screaming_snake_case }} = "{{ group.metric_name }}";

{# `tojson` here, unlike the Rust template: a TypeScript string literal cannot
   span a raw newline, so JSON's escaping is the safe choice even though it
   spells `'` as the noisier `\u0027`. #}
/** `{{ group.metric_name }}` description (the registry `brief`). */
export const {{ group.metric_name | screaming_snake_case }}_DESCRIPTION = {{ group.brief | trim | tojson }};

/** `{{ group.metric_name }}` unit (UCUM). */
export const {{ group.metric_name | screaming_snake_case }}_UNIT = "{{ group.unit }}";
{% endfor %}

// Attribute keys.
{% for group in ctx.groups | selectattr("type", "equalto", "attribute_group") %}
{% for attr in group.attributes %}
/** `{{ attr.name }}` attribute key. */
export const {{ attr.name | screaming_snake_case }} = "{{ attr.name }}";
{% endfor %}
{% endfor %}
